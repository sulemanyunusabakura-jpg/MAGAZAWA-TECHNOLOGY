<!DOCTYPE html>
<html>
<head><title>Login</title><link rel="stylesheet" href="/style.css"></head>
<body>
  <div class="container" style="max-width: 400px;">
    <h2>Portal Login</h2>
    <% if (error) { %><p style="color:red;"><%= error %></p><% } %>
    <form action="/login" method="POST">
      <div class="form-group"><label>Email or Registration Number:</label><input type="text" name="identifier" required></div>
      <div class="form-group"><label>Password:</label><input type="password" name="password" required></div>
      <button type="submit" class="btn" style="width:100%;">Login</button>
    </form>
    <br><p>Need to apply? <a href="/">Click here</a></p>
  </div>
</body>
</html>