<!DOCTYPE html>
<html>
<head>
  <title>Live Classroom - Magazawa Tech</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <div class="container">
    <div class="flex-space">
      <div>
        <h2 style="color: #0056b3;">MAGAZAWA TECHNOLOGY AND SCIENCE</h2>
        <p style="color: #666;">Live Classroom Hall</p>
      </div>
      <a href="/dashboard" class="btn">Back to Dashboard</a>
    </div>
    <hr><br>

    <!-- FIXED VOICE STREAMING STATION -->
    <div class="card" style="background: #212529; color: #fff;">
      <h3 style="color: #ffc107;">🎙️ Live Voice Broadcasting Station</h3>
      <% if (user.role === 'admin') { %>
        <p>Logged in as <strong>Admin / Lecturer</strong>.</p>
        <button id="startAudioBtn" class="btn btn-success">Start Live Voice Broadcast 🎙️</button>
        <button id="stopAudioBtn" class="btn btn-danger" style="display:none;">Stop Broadcast ⏹️</button>
        <p id="micStatus" style="margin-top:10px; color:#28a745;"></p>
      <% } else { %>
        <p>Logged in as Student: <strong><%= user.fullname %></strong></p>
        <button id="listenBtn" class="btn btn-success">Enable Live Audio Speaker 🔊</button>
        <p id="audioStatus" style="margin-top:10px; color:#17a2b8;"></p>
      <% } %>
    </div>

    <!-- ASK QUESTION -->
    <div class="card">
      <h3>Transmit Question to Lecturer</h3>
      <form action="/lecture/ask" method="POST">
        <textarea name="question" rows="3" placeholder="Type your question..." required></textarea><br><br>
        <button type="submit" class="btn">Send Question 📤</button>
      </form>
    </div>

    <!-- QUESTION STREAM WITH FULL STUDENT DETAILS -->
    <div class="card">
      <h3>Live Student Question Stream</h3>
      <% if (questions.length === 0) { %>
        <p>No questions submitted yet.</p>
      <% } else { %>
        <% questions.forEach(q => { %>
          <div style="background: #f8f9fa; border-left: 4px solid #0056b3; padding: 10px; margin-bottom: 12px;">
            <p style="margin-bottom: 5px; color: #333;">
              <strong>👤 Name:</strong> <%= q.student_name %> | 
              <strong>🏫 Dept:</strong> <%= q.student_dept %> | 
              <strong>🎓 Reg No:</strong> <%= q.student_reg %>
            </p>
            <p style="font-size: 16px; margin: 0; color: #000;"><strong>Question:</strong> "<%= q.question %>"</p>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <script>
    const socket = io();

    socket.emit('join-lecture', { role: '<%= user.role %>' });

    // LECTURER VOICE BROADCASTER (MIC)
    const startAudioBtn = document.getElementById('startAudioBtn');
    const stopAudioBtn = document.getElementById('stopAudioBtn');
    const micStatus = document.getElementById('micStatus');
    let mediaRecorder;

    if (startAudioBtn) {
      startAudioBtn.addEventListener('click', async () => {
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });
          
          mediaRecorder.ondataavailable = (event) => {
            if (event.data.size > 0) {
              socket.emit('audio-stream', event.data);
            }
          };

          mediaRecorder.start(200); // Broadcast every 200ms
          micStatus.innerText = "🔴 Live Voice Broadcasting Active...";
          startAudioBtn.style.display = 'none';
          stopAudioBtn.style.display = 'inline-block';
        } catch (err) {
          alert('Microphone access denied. Please allow microphone permission in your browser.');
        }
      });

      stopAudioBtn.addEventListener('click', () => {
        if (mediaRecorder) {
          mediaRecorder.stop();
          micStatus.innerText = "Broadcast ended.";
          startAudioBtn.style.display = 'inline-block';
          stopAudioBtn.style.display = 'none';
        }
      });
    }

    // STUDENT VOICE RECEIVER (SPEAKER)
    const listenBtn = document.getElementById('listenBtn');
    const audioStatus = document.getElementById('audioStatus');
    let audioContext;

    if (listenBtn) {
      listenBtn.addEventListener('click', () => {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        audioStatus.innerText = "🟢 Speaker Active. Listening for lecturer voice...";
        listenBtn.style.display = 'none';
      });

      socket.on('audio-stream', async (buffer) => {
        if (!audioContext) return;
        try {
          const blob = new Blob([buffer], { type: 'audio/webm' });
          const audioUrl = URL.createObjectURL(blob);
          const audio = new Audio(audioUrl);
          audio.play().catch(() => {});
        } catch (e) {}
      });
    }
  </script>
</body>
</html>