<!DOCTYPE html>
<html>
<head>
  <title>Lecturer Dashboard - Magazawa Tech</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <div class="flex-space">
      <div>
        <h2>MAGAZAWA TECHNOLOGY AND SCIENCE</h2>
        <p>Lecturer Workspace Portal</p>
      </div>
      <a href="/logout" class="btn btn-danger">Logout</a>
    </div>
    <hr><br>

    <div class="card flex-space">
      <div>
        <h3>👨‍🏫 Welcome, <%= lecturer.fullname %></h3>
        <p><strong>Course Managed:</strong> <%= lecturer.course %></p>
        <p><strong>Phone:</strong> <%= lecturer.phone %></p>
        <p><strong>Email:</strong> <%= lecturer.email %></p>
      </div>
      <a href="/lecture-room" class="btn">🎙️ Join Live Audio Room</a>
    </div>

    <!-- ADD AND REMOVE STUDENT ACADEMIC RESULTS -->
    <div class="card">
      <h3>📊 Upload & Manage Student Results</h3>
      <form action="/lecturer/add-result" method="POST">
        <div class="form-group">
          <label>Select Student:</label>
          <select name="student_id" required>
            <% students.filter(s => s.status === 'Admitted').forEach(st => { %>
              <option value="<%= st.id %>"><%= st.fullname %> (<%= st.reg_no || 'Pending Reg' %>) - <%= st.course %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Course Code (e.g., CPE 201):</label>
          <input type="text" name="course_code" required>
        </div>
        <div class="form-group">
          <label>Course Title (e.g., Circuit Theory):</label>
          <input type="text" name="course_title" required>
        </div>
        <div class="form-group">
          <label>Score (0 - 100%):</label>
          <input type="number" name="score" min="0" max="100" required>
        </div>
        <button type="submit" class="btn btn-success">Publish Result 📈</button>
      </form>

      <br>
      <h4>Published Results List</h4>
      <% if (publishedResults.length === 0) { %>
        <p>No student results published yet.</p>
      <% } else { %>
        <table>
          <tr>
            <th>Student</th>
            <th>Reg No</th>
            <th>Course Code</th>
            <th>Score</th>
            <th>Grade</th>
            <th>Action</th>
          </tr>
          <% publishedResults.forEach(r => { %>
            <tr>
              <td><strong><%= r.student_name %></strong></td>
              <td><%= r.reg_no %></td>
              <td><%= r.course_code %></td>
              <td><%= r.score %>%</td>
              <td><strong><%= r.grade %></strong></td>
              <td>
                <form action="/lecturer/delete-result/<%= r.id %>" method="POST">
                  <button type="submit" class="btn btn-danger" style="padding:4px 8px; font-size:12px;">Delete Result 🗑️</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </table>
      <% } %>
    </div>

    <!-- VIEW APPLICANT / STUDENT APPLICATION CREDENTIALS -->
    <div class="card">
      <h3>📁 Student Credentials & Application Files</h3>
      <table>
        <tr>
          <th>Passport</th>
          <th>Student Details</th>
          <th>Primary School</th>
          <th>Secondary School</th>
          <th>Uploaded Application File</th>
        </tr>
        <% students.forEach(st => { %>
          <tr>
            <td>
              <% if(st.passport) { %>
                <img src="/uploads/<%= st.passport %>" style="width:50px; height:50px; border-radius:50%; object-fit:cover;">
              <% } else { %>No Photo<% } %>
            </td>
            <td>
              <strong><%= st.fullname %></strong><br>
              <small style="color:#00d8fe;"><%= st.reg_no || 'Not Admitted Yet' %></small><br>
              <small><%= st.email %></small>
            </td>
            <td><%= st.primary_school || 'N/A' %></td>
            <td><%= st.secondary_school || 'N/A' %></td>
            <td>
              <% if(st.result_file) { %>
                <a href="/uploads/<%= st.result_file %>" target="_blank" style="color:#00d8fe;">📄 View Document</a>
              <% } else { %>No Document<% } %>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>

    <!-- UPLOAD LECTURE NOTES -->
    <div class="card">
      <h3>📚 Upload Lecture Materials</h3>
      <form action="/lecturer/upload-note" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label>Lecture Title / Topic:</label>
          <input type="text" name="title" placeholder="e.g. Chapter 1: Circuit Analysis" required>
        </div>
        <div class="form-group">
          <label>Select Document File (PDF, DOCX, TXT):</label>
          <input type="file" name="note_file" required>
        </div>
        <button type="submit" class="btn btn-success">Upload Note 📤</button>
      </form>
    </div>

    <!-- ANNOUNCEMENTS -->
    <div class="card">
      <h3>📢 Broadcast Announcement</h3>
      <form action="/lecturer/post-announcement" method="POST">
        <div class="form-group">
          <textarea name="message" rows="3" placeholder="Type message for your students..." required></textarea>
        </div>
        <button type="submit" class="btn btn-success">Publish Announcement</button>
      </form>
    </div>

  </div>
</body>
</html>